APP_NAME=TechnoFix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: APP_URL=https://technofixbd.com
APP_URL=http://127.0.0.1:8000

# Control panel URL path (use something non-obvious in production)
ADMIN_PATH=admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Dhaka
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=technofix
DB_USERNAME=root
DB_PASSWORD=
# Folder of mysqldump for backups when it is not on the PATH (e.g. C:/MAMP/bin/mysql/bin); empty on cPanel
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Image conversions: false = make WebP sizes during upload (no worker needed); true = queue them (production cron worker)
QUEUE_CONVERSIONS_BY_DEFAULT=false

CACHE_STORE=database
# Cache admin-managed settings (cleared automatically when saved)
SETTINGS_CACHE_ENABLED=true
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@technofixbd.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Guest page cache (App\Support\PageCache). Turn off only to debug.
PAGE_CACHE=true
PAGE_CACHE_MINUTES=30

# Behind Cloudflare: "cloudflare" (lets Cloudflare pass on the visitor address). Never "*".
TRUSTED_PROXIES=
